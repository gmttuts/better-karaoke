{
  "manifest_version": 3,
  "name": "Better Karaoke",
  "version": "0.28.0",
  "key": "",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "https://lrclib.net/*",
    "https://hopamchuan.com/*",
    "https://genius.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/lang/en.js",
        "src/lang/zh.js",
        "src/lang/ja.js",
        "src/lang/ko.js",
        "src/lang/th.js",
        "src/lang/id.js",
        "src/lang/es.js",
        "src/lang/pt.js",
        "src/lang/fr.js",
        "src/lang/de.js",
        "src/lang/ru.js",
        "src/content/util.js",
        "src/content/history.js",
        "src/content/youtube.js",
        "src/content/sources.js",
        "src/content/align.js",
        "src/content/panel-css.js",
        "src/content/looks.js",
        "src/content/romanize.js",
        "src/content/ocr.js",
        "src/content/audiofx.js",
        "src/content/ui-editor.js",
        "src/content/ui-tap.js",
        "src/content/ui-tabs.js",
        "src/content/ui-compare.js",
        "src/content/translate.js",
        "src/content/ui.js",
        "src/content/export.js",
        "src/content/keys.js",
        "src/content/score.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "icons/icon48.png",
        "data/pinyin.json",
        "src/audio/pitch-worklet.js",
        "src/audio/vocal-worklet.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Better Karaoke",
    "default_popup": "src/options/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "default_locale": "en",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
