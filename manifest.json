{
  "manifest_version": 3,
  "name": "Better YouTube Lyric",
  "version": "0.7.1",
  "description": "Tìm lời bài hát ngay trên YouTube (comment, bản đăng lại, LRCLIB, Hợp âm chuẩn, phụ đề) và hát karaoke trên video.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://lrclib.net/*", "https://hopamchuan.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/content/util.js",
        "src/content/youtube.js",
        "src/content/sources.js",
        "src/content/align.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2"], "matches": ["https://www.youtube.com/*"] }
  ],
  "action": {
    "default_title": "Better YouTube Lyric",
    "default_popup": "src/options/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  }
}
